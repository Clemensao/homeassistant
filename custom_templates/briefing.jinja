{# Daily Briefing #}
{%- macro getCurrentWeather() -%}
  {{ ['Es ist', 'Das Wetter ist','Draußen ist es'] | random }} {{state_translated('weather.tomorrow_io_home_daily')}},
  {{ ['bei', 'und','die Temperatur liegt bei'] | random }} {{state_attr('weather.tomorrow_io_home_daily','temperature')|float(0)|round}} Grad.
{%- endmacro -%}

{%- macro getWeatherForecast() -%}
  {{ ['Heute wird es', 'Im weiteren Verlauf wird es','Die Vorhersage: '] | random }} {{state_translated('sensor.weather_forecast_today')}},
  {{ ['bei', 'und','die Temperatur erreicht'] | random }} {{states('sensor.temperature_forecast_today')|float(0)|round}} Grad.
{%- endmacro -%}



{%- macro getReport() -%}
    {% if now().strftime('%H')|int < 12 %}
        Guten Morgen 
    {% elif now().strftime('%H')|int >= 12 and now().strftime('%H')|int < 17 %}
        Hallo  
    {% else %}
        Guten Abend 
    {% endif %}
    Clemens. 
   
    {% from 'macros.jinja' import weekday %}
    {% from 'macros.jinja' import monthname %}
    Heute ist {{ weekday(now().weekday()) }} der {{ as_timestamp(now()) | timestamp_custom('%-d.') }} {{ monthname(now().month-1) }}.
   
    {{ getCurrentWeather() }}
    {{ getWeatherForecast() }}
    
    {{ ['Genieße den Tag!','Komm gut in den Tag!','Peace Brudi'] | random }}
   
{%- endmacro -%}

{# a macro that removes all newline characters, empty spaces, and returns formatted text  #}
{%- macro cleanup(data) -%}
    {%- for item in data.split("\n")  if item | trim != "" -%}
    {{ item | trim }} {% endfor -%}
{%- endmacro -%}

{# a macro to call all macros :)  #}
{%- macro main() -%}
    {{ cleanup(getReport()) }}
{%- endmacro -%}